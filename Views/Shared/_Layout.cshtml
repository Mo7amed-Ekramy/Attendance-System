@{
    // جلب بيانات المستخدم من الـ Claims
    var userRole = Context.User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest";
    var userName = Context.User?.Identity?.Name ?? "Guest User";
    // أول حرف من الاسم للـ Avatar
    var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "G";
    
    string GetDashboardLink(string role)
    {
        return role switch
        {
            "Student" => "/Student/Dashboard",
            "TA" => "/TA/Dashboard",
            "Doctor" => "/Doctor/Dashboard",
            "Admin" => "/Admin/Dashboard",
            _ => "/"
        };
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Attendance System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC_PROJECT.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>
<body class="dashboard-body">

    <nav class="navbar navbar-expand-lg top-navbar fixed-top shadow-sm">
        <div class="container-fluid">
            <button class="navbar-toggler d-lg-none border-0" type="button" id="sidebarToggle">
                <i class="fas fa-bars text-white"></i>
            </button>

            <a class="navbar-brand d-none d-lg-flex align-items-center" href="@GetDashboardLink(userRole)">
                <i class="fas fa-graduation-cap me-2"></i>
                <span class="fw-bold">Attendance System</span>
            </a>

            <div class="search-form ms-auto me-3 d-none d-md-flex">
                <div class="input-group">
                    <input type="text" class="form-control search-input" placeholder="Search courses, students...">
                    <button class="btn search-btn" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>

            <div class="user-menu d-flex align-items-center">
                <div class="dropdown me-3">
                    @{ var currentUserId = MVC_PROJECT.Extensions.ClaimsPrincipalExtensions.GetUserId(Context.User); }
                    <button id="notificationsToggle" class="btn btn-link text-white p-0 position-relative" type="button" data-bs-toggle="dropdown" data-user-id="@currentUserId" data-user-role="@userRole">
                        <i class="fas fa-bell fs-5"></i>
                        <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-light" style="display:none">0</span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notification-dropdown shadow-lg border-0" id="notificationDropdown">
                        <h6 class="dropdown-header">Recent Notifications</h6>
                        <div id="notificationItems" class="px-2 py-1">Loading...</div>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item text-center small text-primary" href="/Notifications">View All</a>
                    </div>
                </div>

                <div class="dropdown">
                    <button class="btn btn-link text-white p-0 d-flex align-items-center text-decoration-none" type="button" data-bs-toggle="dropdown">
                        <div class="user-avatar-sm me-2">
                            @userInitial
                          </div>
                        <span class="user-name d-none d-sm-inline">@userName</span>
                        <i class="fas fa-chevron-down ms-2 small"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user me-2"></i>Profile</a></li>
                        <li><a class="dropdown-item" href="/Account/Settings"><i class="fas fa-cog me-2"></i>Settings</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form method="post" action="/Account/Logout">
                                <button class="dropdown-item text-danger" type="submit">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="dashboard-layout">

        <!-- SIDEBAR -->
        <div class="sidebar-wrapper" id="sidebarWrapper">
            <div class="sidebar">

                <div class="sidebar-header d-lg-none">
                    <div class="d-flex justify-content-between align-items-center p-3">
                        <span class="fw-bold text-white">Menu</span>
                        <button class="btn text-white" id="sidebarClose">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>

                <div class="sidebar-user text-center p-4">
                    <div class="user-avatar mx-auto mb-3">@userInitial</div>
                    <div class="user-info">
                        <div class="user-name fw-bold text-white">@userName</div>
                        <div class="user-role mt-1">
                            <span class="role-badge @userRole.ToLower()">@userRole</span>
                        </div>
                    </div>
                </div>

                <nav class="sidebar-nav">
                    <ul class="nav flex-column">

                        @if (userRole == "Student")
                        {
                            <li class="nav-item">
                                <a class="nav-link active" href="/Student/Dashboard">
                                    <i class="fas fa-home me-2"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Student/Courses">
                                    <i class="fas fa-book me-2"></i> My Courses
                                </a>
                            </li>
                            
                    

                            <li class="nav-item">
                                <a class="nav-link" href="/Notifications/Index">
                                    <i class="fas fa-bell me-2"></i> Notifications
                                </a>
                            </li>
                        }

                        else if (userRole == "TA")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/TA/Dashboard">
                                    <i class="fas fa-home me-2"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/TA/ManageSections">
                                    <i class="fas fa-users me-2"></i> My Sections
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/TA/SelectSectionForAttendance">
                                    <i class="fas fa-calendar-check me-2"></i> Take Attendance
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/TA/SelectSectionForQuiz">
                                    <i class="fas fa-plus-circle me-2"></i> Create Quiz
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/TA/SelectQuizForGrading">
                                    <i class="fas fa-tasks me-2"></i> Record Quiz Marks
                                </a>
                            </li>
                        }

                        else if (userRole == "Doctor")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Doctor/Dashboard">
                                    <i class="fas fa-home me-2"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Doctor/MyCourses">
                                    <i class="fas fa-book me-2"></i> My Courses
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Doctor/LectureReports">
                                    <i class="fas fa-chart-line me-2"></i> Reports
                                </a>
                            </li>
                        }

                        else if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Dashboard">
                                    <i class="fas fa-home me-2"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Users">
                                    <i class="fas fa-users me-2"></i> Users
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Admin/Courses">
                                    <i class="fas fa-book me-2"></i> Courses
                                </a>
                            </li>
                        }

                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/">
                                    <i class="fas fa-home me-2"></i> Home
                                </a>
                            </li>
                        }

                    </ul>
                </nav>

            </div>
        </div>

        <!-- MAIN -->
        <main class="main-content">

            <div class="breadcrumb-container mt-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0">
                        <li class="breadcrumb-item">
                            <a href="/Dashboard" class="text-decoration-none">
                                <i class="fas fa-home"></i> Dashboard
                            </a>
                        </li>
                    </ol>
                </nav>
            </div>

            <div class="page-header mb-4">
                <h1 class="page-title h2">@ViewData["Title"]</h1>
                <p class="text-muted">@ViewData["Subtitle"]</p>
            </div>

            <div class="content-wrapper shadow-sm border-0 rounded-4 p-4 bg-white">
                @RenderBody()
            </div>

            <footer class="footer mt-auto py-4 text-center">
                <span class="text-muted small">
                    © @DateTime.Now.Year - University Attendance System
                </span>
            </footer>

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        (function () {
            const badge = document.getElementById('notificationBadge');
            const itemsContainer = document.getElementById('notificationItems');
            const toggleBtn = document.getElementById('notificationsToggle');
            const userId = toggleBtn ? parseInt(toggleBtn.getAttribute('data-user-id')) : 0;
            const userRole = toggleBtn ? toggleBtn.getAttribute('data-user-role') : null;

            function formatTime(dtStr) {
                try {
                    const d = new Date(dtStr);
                    const diff = Math.floor((Date.now() - d.getTime()) / 1000);
                    if (diff < 60) return diff + 's ago';
                    if (diff < 3600) return Math.floor(diff / 60) + 'm ago';
                    if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';
                    return d.toLocaleString();
                } catch { return '' }
            }

            async function loadRecent() {
                if (!userId || userId <= 0) return;
                try {
                    const res = await fetch('/Notifications/Recent');
                    const data = await res.json();
                    if (!data || !data.success) return;

                    const unread = data.unreadCount || 0;
                    if (unread > 0) {
                        badge.style.display = 'inline-block';
                        badge.textContent = unread;
                    } else {
                        badge.style.display = 'none';
                    }

                    const notifs = data.notifications || [];
                    if (!notifs.length) {
                        itemsContainer.innerHTML = '<div class="p-2 small text-muted">No notifications</div>';
                        // update student dashboard area if present
                        const studentContainer = document.getElementById('studentRecentNotifications');
                        const studentBadge = document.getElementById('studentHeaderNotifBadge');
                        const studentNo = document.getElementById('studentNoNotifications');
                        if (studentContainer) {
                            studentContainer.innerHTML = '<div id="studentNoNotifications" class="text-muted text-center py-4">\n                            <i class="fas fa-bell-slash fa-2x mb-3"></i>\n                            <p class="mb-0">No notifications yet</p>\n                        </div>';
                        }
                        if (studentBadge) studentBadge.style.display = 'none';
                        return;
                    }

                    itemsContainer.innerHTML = '';
                    notifs.slice(0,8).forEach(n => {
                        const item = document.createElement('a');
                        item.href = '/Notifications';
                        item.className = 'dropdown-item d-flex align-items-start';
                        item.innerHTML = `
                            <div class="me-2 notification-icon bg-primary text-white rounded-circle p-2"><i class="fas fa-bell"></i></div>
                            <div class="notification-content flex-grow-1">
                                <div class="notification-title fw-bold">${n.title}</div>
                                <div class="notification-time small text-muted">${formatTime(n.createdAt)}</div>
                            </div>`;
                        itemsContainer.appendChild(item);
                    });

                    // also update student dashboard card if present
                    const studentContainer = document.getElementById('studentRecentNotifications');
                    const studentBadge = document.getElementById('studentHeaderNotifBadge');
                    const studentNo = document.getElementById('studentNoNotifications');
                    if (studentContainer) {
                        studentContainer.innerHTML = '';
                        notifs.slice(0,5).forEach(n => {
                            const div = document.createElement('div');
                            div.className = 'border rounded p-3 mb-2 student-notification-item';
                            div.innerHTML = `<div class="fw-bold small">${n.title}</div><div class="text-muted small">${formatTime(n.createdAt)}</div>`;
                            studentContainer.appendChild(div);
                        });
                        if (studentNo) studentNo.style.display = 'none';
                    }
                    if (studentBadge) {
                        if (data.unreadCount && data.unreadCount > 0) {
                            studentBadge.style.display = 'inline-block';
                            studentBadge.textContent = data.unreadCount;
                        } else {
                            studentBadge.style.display = 'none';
                        }
                    }
                } catch (e) {
                    console.error('Failed to load notifications', e);
                }
            }

            // SignalR connection
            if (userId && userId > 0) {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl('/notificationHub')
                    .withAutomaticReconnect()
                    .build();

                connection.on('ReceiveNotification', function (payload) {
                    try {
                        // increment badge
                        const current = parseInt(badge.textContent) || 0;
                        badge.style.display = 'inline-block';
                        badge.textContent = current + 1;

                        // prepend new notification
                        const a = document.createElement('a');
                        a.href = '/Notifications';
                        a.className = 'dropdown-item d-flex align-items-start';
                        const title = payload.title || payload.titleText || 'Notification';
                        const message = payload.message || '';
                        const createdAt = payload.createdAt || new Date().toISOString();
                        a.innerHTML = `
                            <div class="me-2 notification-icon bg-primary text-white rounded-circle p-2"><i class="fas fa-bell"></i></div>
                            <div class="notification-content flex-grow-1">
                                <div class="notification-title fw-bold">${title}</div>
                                <div class="notification-time small text-muted">${formatTime(createdAt)}</div>
                            </div>`;

                        if (itemsContainer.firstChild) itemsContainer.insertBefore(a, itemsContainer.firstChild);
                        else itemsContainer.appendChild(a);

                        // update student dashboard card if present
                        try {
                            const studentContainer = document.getElementById('studentRecentNotifications');
                            const studentBadge = document.getElementById('studentHeaderNotifBadge');
                            const studentNo = document.getElementById('studentNoNotifications');
                            if (studentContainer) {
                                const div = document.createElement('div');
                                div.className = 'border rounded p-3 mb-2 student-notification-item';
                                div.innerHTML = `<div class="fw-bold small">${title}</div><div class="text-muted small">${formatTime(createdAt)}</div>`;
                                if (studentContainer.firstChild) studentContainer.insertBefore(div, studentContainer.firstChild);
                                else studentContainer.appendChild(div);
                                if (studentNo) studentNo.style.display = 'none';
                            }

                            if (studentBadge) {
                                const cur = parseInt(studentBadge.textContent) || 0;
                                studentBadge.style.display = 'inline-block';
                                studentBadge.textContent = cur + 1;
                            }
                        } catch (e) { console.error(e); }
                    } catch (e) { console.error(e); }
                });

                connection.start().then(function () {
                    console.log('[SignalR] connection started');
                    // join student group when role is Student (case-insensitive)
                    try {
                        if (userRole && userRole.toString().toLowerCase() === 'student') {
                            console.log('[SignalR] invoking JoinStudentGroup', userId);
                            connection.invoke('JoinStudentGroup', userId).then(() => console.log('[SignalR] joined Student group')).catch(err => console.error('[SignalR] JoinStudentGroup failed', err));
                        }
                    } catch (e) { console.error('[SignalR] join group error', e); }
                }).catch(err => console.error('[SignalR] connection start failed', err.toString()));

                connection.onclose(e => {
                    console.warn('[SignalR] connection closed', e);
                });
            }

            // initial load
            document.addEventListener('DOMContentLoaded', loadRecent);
        })();
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const toggle = document.getElementById('sidebarToggle');
            const close = document.getElementById('sidebarClose');
            const wrapper = document.getElementById('sidebarWrapper');

            if (toggle) toggle.addEventListener('click', () => wrapper.classList.add('show'));
            if (close) close.addEventListener('click', () => wrapper.classList.remove('show'));

            // Highlighting active nav link based on URL
            const path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
                const href = link.getAttribute('href').toLowerCase();
                if (path === href || (href !== '/dashboard' && path.startsWith(href))) {
                    link.classList.add('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>