@model MVC_PROJECT.ViewModels.Attendance.SectionAttendanceViewModel

<h3>@Model.CourseName - Section @Model.SectionNumber</h3>
<p>@Model.DepartmentName</p>

<form method="post">

    <input type="hidden" name="CourseSectionId" value="@Model.CourseSectionId" />

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>University ID</th>
                <th>Present</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < Model.Students.Count; i++)
            {
                <tr>
                    <td>@Model.Students[i].FullName</td>
                    <td>@Model.Students[i].UniversityId</td>

                    <td>
                        <input type="hidden" name="Students[@i].EnrollmentId" value="@Model.Students[i].EnrollmentId" />
                        <input type="checkbox" name="Students[@i].IsPresent" value="true" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-success">Save Attendance</button>
    <button type="button"
            class="btn btn-dark ms-2"
            id="generateQrBtn">
        Generate QR
    </button>
    <div id="qrContainer" class="mt-4"></div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @* <p>@Model.AttendanceSessionId</p> Test the session id *@
    <script>
        $("#generateQrBtn").click(function () {

            $.post('/Attendance/GenerateQr', {
                attendanceSessionId: @Model.AttendanceSessionId
            }, function (data) {

                if (data.success) {

                    $("#qrContainer").html(`
                        <div class="card p-3 text-center mt-3">
                            <img src="${data.qrImage}" width="250"/>
                            <h5 class="mt-3">Code: ${data.code}</h5>
                        </div>
                    `);
                }
            });

        });
    </script>

</form>