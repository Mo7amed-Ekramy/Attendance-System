@model MVC_PROJECT.ViewModels.Quiz.RecordQuizMarksViewModel

<h2>@Model.QuizTitle - Record Marks</h2>

<form asp-action="RecordQuizMarks" method="post">
    <input type="hidden" asp-for="QuizId" />

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>University ID</th>
                <th>Mark</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.Students.Count; i++)
            {
                <tr>
                    <td>@Model.Students[i].FullName</td>
                    <td>@Model.Students[i].UniversityId</td>
                    <td>
                        <input type="number"
                               asp-for="Students[i].Mark"
                               class="form-control" />
                        <input type="hidden" asp-for="Students[i].EnrollmentId" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">Save</button>
</form>