@{
    ViewData["Title"] = "Login";
    Layout = null;
}
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #3b1f0f, #8b5e3c);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center; /* يخليهم في نفس المستوى */
            gap: 10px; /* مسافة بينهم */
        }

            .logo-container img {
                width: 90px; /* عدل حسب الحجم اللي عايزه */
            }

            .logo-container span {
                font-weight: 600;
                font-size: 16px;
            }

        .remember-wrapper {
            margin-top: 15px;
            display: flex;
            justify-content: flex-start; /* أو flex-end لو عايزها يمين */
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .remember input {
                width: 16px;
                height: 16px;
                cursor: pointer;
            }

            .remember label {
                cursor: pointer;
                font-size: 14px;
            }

        .container {
            width: 900px;
            height: 520px;
            display: flex;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }

        .left {
            flex: 1;
            background: linear-gradient(135deg, #4a2c1d, #8b5e3c);
            color: white;
            padding: 40px;
        }

            .left h1 {
                margin-top: 60px;
                font-size: 32px;
            }

            .left p {
                margin-top: 10px;
                opacity: 0.8;
            }

        .right {
            flex: 1;
            background: #f4efe9;
            padding: 40px;
        }

            .right h2 {
                margin-bottom: 5px;
            }

        .form-group {
            margin-top: 20px;
        }

        input {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #ccc;
            outline: none;
        }

        .btn {
            margin-top: 25px;
            width: 100%;
            padding: 12px;
            background: #8b5e3c;
            border: none;
            color: white;
            border-radius: 10px;
            cursor: pointer;
            font-weight: bold;
        }

            .btn:hover {
                background: #6f472b;
            }
    </style>
</head>

<body>

    <div class="container">

        <!-- LEFT -->
        <div class="left">
            <div class="logo-container">
                <img src="~/images/national_university_logo_2.png" />
                <span>Assiut National University</span>
            </div>
            <h1>Welcome Back </h1>
            <p>Sign in to access your university Account</p>
        </div>

        <!-- RIGHT -->
        <div class="right">
            <h2>Sign In</h2>

            <form method="post" action="/Account/Login">

                <div class="form-group">
                    <label>Username</label>
                    <input name="UserName" placeholder="Enter username" />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input name="Password" type="password" placeholder="Enter password" />
                </div>

                <button class="btn" type="submit">
                    Sign In
                </button>

                <div class="remember-wrapper">
                    <div class="remember">
                        <input type="checkbox" id="remember" name="Remember_me" />
                        <label for="remember">Remember me</label>
                    </div>
                </div>
                

            </form>

        </div>

    </div>

</body>
</html>