@model MVC_PROJECT.ViewModels.Student.StudentCourseDetailsViewModel

@{
    ViewData["Title"] = "Course Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">@Model.CourseCode - @Model.CourseName</h1>
        <p class="text-muted mb-0">Section @Model.SectionNumber | Dr. @Model.DoctorName</p>
    </div>
    <div>
        <a href="/Student/MyCourses" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-2"></i> Back to Courses
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold"><i class="fas fa-chart-line me-2 text-primary"></i> Course Progress</h6>
                <span class="badge bg-success">Safe</span>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-3 mb-3">
                        <div class="text-center">
                            <div class="display-4 fw-bold text-primary">92%</div>
                            <div class="text-muted">Attendance</div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="text-center">
                            <div class="display-4 fw-bold text-info">@Model.QuizMarks</div>
                            <div class="text-muted">Quiz Average</div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="text-center">
                            <div class="display-4 fw-bold text-success">A</div>
                            <div class="text-muted">Current Grade</div>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="text-center">
                            <div class="display-4 fw-bold text-warning">@Model.AbsenceCount/@Model.AllowedAbsences</div>
                            <div class="text-muted">Absences Used</div>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold mb-3">Attendance Progress</h6>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar bg-success" style="width:@(100 - ((Model.AbsenceCount * 100) / (Model.AllowedAbsences == 0 ? 1 : Model.AllowedAbsences)))%">
                            <span class="fw-bold">
                                @(
                                                                Model.AllowedAbsences == 0
                                                                ? 0
                                                                : (100 - ((Model.AbsenceCount * 100) / Model.AllowedAbsences))
                                                                ) %
                            </span>
                        </div>
                    </div>
                    <div class="mt-2 text-muted small">
                        <i class="fas fa-info-circle me-1"></i> @Model.AbsenceCount absences used out of @Model.AllowedAbsences
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold mb-3">Course Policy</h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Total Coursework Marks</span>
                                <span class="fw-bold">@Model.TotalCourseworkMarks</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Section Attendance</span>
                                <span class="fw-bold">@Model.SectionAttendanceMarks marks</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Quiz Marks</span>
                                <span class="fw-bold">@Model.QuizMarks marks</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Lecture Attendance</span>
                                <span class="fw-bold">@Model.LectureAttendanceMarks marks</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Allowed Absences</span>
                                <span class="fw-bold">@Model.AllowedAbsences sessions</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-2">
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Best Quizzes Count</span>
                                <span class="fw-bold">Best @Model.BestQuizzesCount quizzes</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h6 class="m-0 fw-bold"><i class="fas fa-calendar-alt me-2 text-primary"></i> Upcoming Sessions</h6>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">

                    @foreach (var session in Model.UpcomingSessions)
                    {
                        <div class="list-group-item border-0">

                            <div class="d-flex justify-content-between align-items-center">

                                <div>
                                    <div class="fw-bold small">
                                        @session.Day, @session.Time
                                    </div>

                                    <div class="text-muted small">
                                        @session.Type - @session.Location
                                    </div>
                                </div>

                                <span class="badge bg-primary">
                                    @session.Type
                                </span>

                            </div>

                        </div>
                    }

                </div>
            </div>
        </div>

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-white">
                <h6 class="m-0 fw-bold"><i class="fas fa-users me-2 text-primary"></i> Teaching Team</h6>
            </div>
            <div class="card-body">
                @foreach (var member in Model.TeachingTeam)
                {
                    <div class="d-flex align-items-center mb-3">

                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3"
                             style="width: 40px; height: 40px;">

                            @member.Name.Substring(0, 1)

                        </div>

                        <div>

                            <div class="fw-bold">
                                @member.Name
                            </div>

                            <div class="text-muted small">
                                @member.Role
                            </div>

                        </div>

                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h6 class="m-0 fw-bold"><i class="fas fa-history me-2 text-primary"></i> Recent Quiz Marks</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Quiz</th>
                        <th>Date</th>
                        <th>Mark</th>
                        <th>Max Mark</th>
                        <th>Weight</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var quiz in Model.QuizItems)
                    {
                        var percentage = quiz.MaxMark == 0
                        ? 0
                        : (quiz.StudentMark * 100) / quiz.MaxMark;

                        <tr>

                            <td>@quiz.QuizTitle</td>

                            <td>@quiz.QuizDate.ToShortDateString()</td>

                            <td class="fw-bold text-success">
                                @quiz.StudentMark/@quiz.MaxMark
                            </td>

                            <td>@quiz.MaxMark</td>

                            <td>@percentage%</td>

                            <td>
                                @if (quiz.IsCounted)
                                {
                                    <span class="badge bg-success">
                                        Counted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Dropped
                                    </span>
                                }
                            </td>

                        </tr>
                    }

                </tbody>
            </table>
        </div>
        <div class="mt-3 text-muted small">
            <i class="fas fa-info-circle me-1"></i>Best @Model.BestQuizzesCount quizzes are counted towards final grade
        </div>
    </div>
</div>