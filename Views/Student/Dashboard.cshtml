@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-container">
    <h2 class="page-title">Dashboard</h2>
    <p class="subtitle">Student • Current Semester</p>

    <!-- Cards -->
    <div class="cards">

        <div class="card-box">
            <div class="icon">%</div>
            <h3>88%</h3>
            <p>Attendance</p>
        </div>

        <div class="card-box">
            <div class="icon">??</div>
            <h3>3</h3>
            <p>Absences</p>
        </div>

        <div class="card-box">
            <div class="icon">??</div>
            <h3>85%</h3>
            <p>Quiz Average</p>
        </div>

    </div>

    <!-- Main Content -->
    <div class="grid">

        <!-- Attendance -->
        <div class="box">
            <h4>Attendance History</h4>

            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Course</th>
                        <th>Section</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Today</td>
                        <td>CS101</td>
                        <td>A1</td>
                        <td class="status present">Present</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Quiz -->
        <div class="box">
            <div class="box-header">
                <h4>Quiz Grades</h4>
                <button class="export-btn">Export</button>
            </div>

            <p class="empty">No quizzes yet.</p>
        </div>

    </div>

    <!-- Notifications -->
    <div class="box">
        <h4>Notifications</h4>
        <p class="empty">No notifications yet</p>
    </div>
    ```

</div>
